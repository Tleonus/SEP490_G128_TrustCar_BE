# TrustCar backend — sample environment variables.
# Copy to `.env` before starting the server. Do NOT commit real secrets.

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trustcar
JWT_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-in-prod-refresh
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# ── Cloudinary (image uploads) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (MailerSend) ─────────────────────────────────────────────────────
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=TrustCar

# ── Firebase (Google Sign-in) ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# ── KAN-22 Deposit settings (optional overrides) ──────────────────────────
DEPOSIT_HOLD_HOURS=24
DEPOSIT_PAID_HOLD_HOURS=0
DEPOSIT_MIN_AMOUNT=5000000
DEPOSIT_MIN_PERCENT=1
DEPOSIT_MAX_PERCENT=30
DEPOSIT_SUGGESTED_PERCENT=5
DEPOSIT_MAX_ACTIVE_PER_CUSTOMER=1
DEPOSIT_JOB_INTERVAL_MS=60000
DEPOSIT_BANK_NAME=
DEPOSIT_BANK_ACCOUNT_NUMBER=
DEPOSIT_BANK_ACCOUNT_NAME=

# ── KAN-99 VNPay sandbox integration ──────────────────────────────────────
# All blank by default → VNPay is DISABLED, deposits fall back to MANUAL flow.
# Register a free sandbox account at https://sandbox.vnpayment.vn and paste the
# tmnCode + hashSecret issued for your test merchant. Use HTTPS URLs for
# returnUrl/ipnUrl — localhost will not work in sandbox.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
# Comma-separated IPs VNPay uses for the IPN callback. Leave blank in dev
# (allows any IP); set the real list in staging/production.
VNPAY_IP_WHITELIST=
VNPAY_TIMEOUT_MINUTES=15
VNPAY_RECONCILE_INTERVAL_MS=300000
VNPAY_LOCALE=vn
