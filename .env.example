# ═══════════════════════════════════════════════════════════════════
# TrustCar Backend – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trustcar?retryWrites=true&w=majority

# ── JWT Configuration ─────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_256_bit_random_secret_never_share_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (Vehicle Image Storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=trustcar_vehicles
CLOUDINARY_FOLDER=trustcar/vehicles

# ── MailerSend (Primary Email Dispatcher) ─────────────────────────────
MAILERSEND_API_KEY=your_mailersend_api_token
MAILERSEND_FROM_EMAIL=noreply@trustcar.vn
MAILERSEND_FROM_NAME=TrustCar Platform

# ── Nodemailer / SMTP (Fallback Email Transport) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ── Rate Limiting ─────────────────────────────────────────────────────
# 900000 ms = 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter limit for auth endpoints
AUTH_RATE_LIMIT_MAX=20

# ── CORS Allowed Origins (comma-separated) ─────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ── Bcrypt ────────────────────────────────────────────────────────────
# Higher rounds = more secure but slower. 12 is recommended for production.
BCRYPT_SALT_ROUNDS=12

# ── Pagination ────────────────────────────────────────────────────────
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
